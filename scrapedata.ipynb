    "# Fisheries policy\n",
    "url_fish = \"https://oeil.secure.europarl.europa.eu/oeil/en/search/export/XML?fullText.mode=EXACT_WORD&term=9th+term+2019+-+2024&subject=3.15+Fisheries+policy&resultsOnly=true\"\n",
    "\n",
    "response_fish = requests.get(url_fish)\n",
    "response_fish.raise_for_status()\n",
    "\n",
    "root1 = ET.fromstring(response_fish.content)\n",
    "\n",
    "data_fish = []\n",
    "\n",
    "for item in root1.find(\"items\").findall(\"item\"):\n",
    "    reference1 = item.findtext(\"reference\", default=\"\")\n",
    "    title1 = item.findtext(\"title\", default=\"\")\n",
    "    \n",
    "    # Extract all rapporteurs \n",
    "    rapporteurs_elem_fish = item.find(\"rapporteur\")\n",
    "    if rapporteurs_elem_fish is not None:\n",
    "        rapporteurs1 = [r.text for r in rapporteurs_elem_fish.findall(\"rapporteur\") if r.text]\n",
    "    else:\n",
    "        rapporteurs1 = ['NaN']\n",
    "\n",
    "    rapporteurs1_str = \", \".join(rapporteurs1) if rapporteurs1 else \"\"\n",
    "\n",
    "    data_fish.append({\n",
    "        \"document_id\": reference1,\n",
    "        \"title\": title1,\n",
    "        \"rapporteurs\": rapporteurs1_str,\n",
    "    })\n",
    "\n",
    "df_fish = pd.DataFrame(data_fish)\n",
    "print(df_fish.head())\n"
   ]
